.encoding = "windows-1252"
config.version = "8"
virtualHW.version = "19"
displayName = "{{DISPLAY_NAME}}"
guestOS = "other-64"
firmware = "efi"
# Storage fails closed without a DMA-remapping unit (D-357): this is VMware's
# virtual VT-d unit, as `-device intel-iommu` is QEMU's (D-358).
vvtd.enable = "TRUE"
# D-390: VMware's CPU-resident hypervisor identity authenticates this structured
# contract that every requester stayed quiescent until the entry-time fence.
acpi.addtable.filename = "{{DMA_HANDOFF_FILE}}"
memsize = "512"
numvcpus = "2"
sata0.present = "TRUE"
sata0:0.present = "TRUE"
sata0:0.fileName = "{{VMDK_NAME}}"
# PCIe root ports. `other-64` gets a bare PCI topology, and VMware's NVMe
# controller is PCIe-only — with no ports declared there is not one slot to put
# it in. These are also what `012` §11 predicted the enumeration would have to
# walk, so the driver's bridge recursion is now reached rather than argued
# (D-176).
pciBridge0.present = "TRUE"
pciBridge4.present = "TRUE"
pciBridge4.virtualDev = "pcieRootPort"
pciBridge4.functions = "8"
pciBridge5.present = "TRUE"
pciBridge5.virtualDev = "pcieRootPort"
pciBridge5.functions = "8"
pciBridge6.present = "TRUE"
pciBridge6.virtualDev = "pcieRootPort"
pciBridge6.functions = "8"
pciBridge7.present = "TRUE"
pciBridge7.virtualDev = "pcieRootPort"
pciBridge7.functions = "8"
# The storage controller Phase 6 drives. `012` §2 chose NVMe because it is the
# one controller with a published specification that this project's two boot
# targets share — and a VM without one tests half of that, which is what the
# first VMware boot to run the checks discovered (D-176).
#
# Two of them, and the first deliberately namespace-less, because `a later nvme
# controller survives an earlier failure` asks whether discovery retires a
# useless candidate and goes on to its sibling. QEMU has been shaped this way
# since D-199; this machine was not, so the one check that needs a second
# controller could never pass here however the human answered (D-240).
nvme0.present = "TRUE"
nvme1.present = "TRUE"
nvme1:0.present = "TRUE"
nvme1:0.fileName = "{{NVME_VMDK_NAME}}"
serial0.present = "TRUE"
serial0.fileType = "file"
serial0.fileName = "{{SERIAL_LOG}}"
usb.present = "TRUE"
svga.autodetect = "TRUE"
extendedConfigFile = "bedrock.vmxf"
virtualHW.productCompatibility = "hosted"
vmxstats.filename = "bedrock.scoreboard"
numa.autosize.vcpu.maxPerVirtualNode = "2"
pciBridge0.pciSlotNumber = "17"
pciBridge4.pciSlotNumber = "21"
pciBridge5.pciSlotNumber = "22"
pciBridge6.pciSlotNumber = "23"
pciBridge7.pciSlotNumber = "24"
usb.pciSlotNumber = "32"
sata0.pciSlotNumber = "33"
nvme0.pciSlotNumber = "160"
nvme1.pciSlotNumber = "192"
nvme1:0.redo = ""
sata0:0.redo = ""
svga.vramSize = "268435456"
vmotion.checkpointFBSize = "134217728"
vmotion.checkpointSVGAPrimarySize = "268435456"
vmotion.svga.mobMaxSize = "268435456"
vmotion.svga.graphicsMemoryKB = "262144"
usb:1.speed = "2"
usb:1.present = "TRUE"
usb:1.deviceType = "hub"
usb:1.port = "1"
usb:1.parent = "-1"
usb:0.present = "TRUE"
usb:0.deviceType = "hid"
usb:0.port = "0"
usb:0.parent = "-1"
